{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portfolios-api",
	"main": "src/index.ts",
	"compatibility_date": "2025-01-01",
	"observability": {
		"enabled": true
	},
	"vars": {
		"ALLOWED_ORIGINS": "https://borrageiros.com,https://www.borrageiros.com,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173"
	},
	"routes": [{ "pattern": "api.borrageiros.com", "custom_domain": true }]
}
